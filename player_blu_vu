 
#include "AudioTools.h"
#include "BluetoothA2DPSink.h"
#include <MD_MAX72xx.h>
#include <SPI.h>

/* ===== I2S PINS ===== */
#define I2S_BCLK  27
#define I2S_LRC   26
#define I2S_DOUT  25

/* ===== MAX7219 ===== */
#define MAX_DEVICES 4
#define CS_PIN 15
MD_MAX72XX mx(MD_MAX72XX::FC16_HW, CS_PIN, MAX_DEVICES);

/* ===== AUDIO ===== */
I2SStream i2s;
BluetoothA2DPSink a2dp_sink(i2s);
volatile uint16_t audioLevel = 0;

/* ===== RAW AUDIO TAP (VU ONLY, SAFE) ===== */
void raw_audio_callback(const uint8_t *data, uint32_t len) {
  int32_t sum = 0;
  int samples = len / 2;
  int16_t *pcm = (int16_t *)data;

  for (int i = 0; i < samples; i++) {
    sum += abs(pcm[i]);
  }
  audioLevel = sum / samples;
}

void setup() {
  Serial.begin(115200);

  esp_bt_controller_mem_release(ESP_BT_MODE_BLE);

  /* I2S CONFIG */
  auto cfg = i2s.defaultConfig(TX_MODE);
  cfg.sample_rate = 44100;
  cfg.channels = 2;
  cfg.bits_per_sample = 16;
  cfg.pin_bck  = I2S_BCLK;
  cfg.pin_ws   = I2S_LRC;
  cfg.pin_data = I2S_DOUT;
  i2s.begin(cfg);

  /* MAX7219 */
  mx.begin();
  mx.control(MD_MAX72XX::INTENSITY, 8);
  mx.clear();

  /* BLUETOOTH */
  a2dp_sink.set_volume(100);
  a2dp_sink.set_raw_stream_reader(raw_audio_callback); // ✅ SAFE TAP
  a2dp_sink.start("ESP32_MUSIC");
}

void loop() {
  uint8_t bars = map(audioLevel, 0, 12000, 0, 32);
  bars = constrain(bars, 0, 32);

  mx.clear();
  for (int i = 0; i < bars; i++) {
    mx.setColumn(i, 0xFF);
  }
  delay(30);
}
