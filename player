#include <WiFi.h>
#include <HTTPClient.h>
#include <driver/i2s.h>
#include "MP3DecoderHelix.h"

using namespace libhelix; 

/* HTTP MP3 STREAM (MP3 ONLY, NOT AAC) */
const char* streamURL = "http://media-ice.musicradio.com/ClassicFMMP3";

/* ================= I2S PIN CONFIG ================= */
#define I2S_BCLK   27
#define I2S_LRC    26
#define I2S_DOUT   25

/* ================= BUFFER ================= */
#define NET_BUFFER_SIZE 16384
uint8_t netBuffer[NET_BUFFER_SIZE];
volatile size_t bufHead = 0;
volatile size_t bufTail = 0;

/* ================= RING BUFFER ================= */
void pushToBuffer(uint8_t *data, size_t len) {
  for (size_t i = 0; i < len; i++) {
    size_t next = (bufHead + 1) % NET_BUFFER_SIZE;
    if (next != bufTail) {
      netBuffer[bufHead] = data[i];
      bufHead = next;
    }
  }
}

size_t popFromBuffer(uint8_t *out, size_t maxLen) {
  size_t count = 0;
  while (bufTail != bufHead && count < maxLen) {
    out[count++] = netBuffer[bufTail];
    bufTail = (bufTail + 1) % NET_BUFFER_SIZE;
  }
  return count;
}

/* ================= I2S INIT ================= */
void i2sInit() {
  i2s_config_t cfg = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = 44100,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = 0,
    .dma_buf_count = 16,
    .dma_buf_len = 1024,
    .use_apll = false,
    .tx_desc_auto_clear = true,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRC,
    .data_out_num = I2S_DOUT,
    .data_in_num = I2S_PIN_NO_CHANGE
  };

  i2s_driver_install(I2S_NUM_0, &cfg, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin);
}

/* ================= MP3 CALLBACK =================
 * IMPORTANT:
 * MUST MATCH:
 * void (*)(MP3FrameInfo&, int16_t*, size_t)
 */
void audioCallback(MP3FrameInfo &info, int16_t *pcm, size_t len) {
  static int currentRate = 44100;

  if (info.samprate != currentRate) {
    i2s_set_sample_rates(I2S_NUM_0, info.samprate);
    currentRate = info.samprate;
  }

  // Volume boost
  float gain = 2.0f;
  for (size_t i = 0; i < len; i++) {
    int32_t s = pcm[i] * gain;
    if (s > INT16_MAX) s = INT16_MAX;
    if (s < INT16_MIN) s = INT16_MIN;
    pcm[i] = s;
  }

  size_t written;
  i2s_write(I2S_NUM_0, pcm, len * sizeof(int16_t), &written, portMAX_DELAY);
}

/* ================= MP3 DECODER ================= */
MP3DecoderHelix mp3(audioCallback);

/* ================= DECODE TASK ================= */
void decodeTask(void *param) {
  uint8_t temp[1024];
  while (true) {
    size_t got = popFromBuffer(temp, sizeof(temp));
    if (got > 0) {
      mp3.write(temp, got);
    } else {
      vTaskDelay(1);
    }
  }
}

/* ================= SETUP ================= */
void setup() {
  Serial.begin(115200);

  WiFi.begin(ssid, password);
  Serial.print("Connecting WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected");

  i2sInit();
  mp3.begin();

  xTaskCreatePinnedToCore(
    decodeTask,
    "decodeTask",
    8192,
    NULL,
    1,
    NULL,
    0
  );
}

/* ================= LOOP ================= */
void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    return;
  }

  HTTPClient http;
  http.begin(streamURL);
  int code = http.GET();

  if (code == HTTP_CODE_OK) {
    WiFiClient *stream = http.getStreamPtr();
    uint8_t buf[1024];

    while (stream->connected()) {
      int len = stream->read(buf, sizeof(buf));
      if (len > 0) {
        pushToBuffer(buf, len);
      } else {
        delay(1);
      }
    }
  }

  http.end();
  delay(1000); // reconnect delay
}
